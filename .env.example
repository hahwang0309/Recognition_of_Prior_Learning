# ═══════════════════════════════════════════════════════════════
#  K-RPL 환경 설정 견본
#
#  쓰는 법:   cp .env.example .env      ← 복사(cp)입니다. 이동(mv)이 아닙니다.
#                                          견본은 저장소에 그대로 남아 있어야 합니다.
#
#  .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.
#  여기에는 **비밀값과 환경마다 달라지는 값**만 둡니다.
#  심사 기준·프롬프트·모델 파라미터는 config/ 아래에 있습니다.
#
#  우선순위:  config/settings.yaml  <  config/environments/{env}.yaml
#             <  이 파일(.env)  <  실행할 때 직접 준 환경변수
#
#  즉 `KRPL_LLM_BACKEND=replay ./scripts/dev.sh assess R2026-0002` 처럼
#  그때그때 지정한 값이 이 파일보다 셉니다.
# ═══════════════════════════════════════════════════════════════


# ── 실행 환경 ──────────────────────────────────────────────────
# local | staging | prod | test  →  config/environments/{값}.yaml 을 덧씌웁니다.
#   local    개발용. 로그 DEBUG, 미확정 기준이 있어도 기동
#   prod     운영용. 미확정 기준이 남아 있으면 기동을 거부합니다
#            (지금은 7건 미확정이라 prod 로 두면 기동되지 않습니다)
#   test     시험 전용. DB 와 감사 산출물을 운영과 분리합니다
KRPL_ENV=local


# ── 데이터베이스 ───────────────────────────────────────────────
# PostgreSQL 접속 문자열. 사용자·비밀번호·호스트·DB 이름을 맞춰 넣습니다.
# 시험은 여기가 아니라 krpl_test 를 씁니다 (tests/conftest.py 가 강제).
KRPL_DATABASE_URL=postgresql+psycopg://krpl:krpl@localhost:5432/krpl


# ── LLM 백엔드 ─────────────────────────────────────────────────
# anthropic | replay
#   anthropic  실제 Claude API 를 부릅니다. 아래 ANTHROPIC_API_KEY 가 있어야 합니다.
#              실측(4건 평균, 2026-08-22): 1건 $2.63 · 6분25초.
#              비용은 시도 수에 비례합니다 — 1건 = 1회가 아닙니다.
#   replay     저장된 산출물을 되돌려 줍니다. 비용 0. 시험·시연용.
#
# 비워 두면: 키가 있으면 anthropic, 없으면 replay 로 알아서 갑니다.
# 실수로 돈이 나가는 게 걱정되면 replay 로 못박아 두십시오.
KRPL_LLM_BACKEND=

# Claude API 키.  https://console.anthropic.com/settings/keys
# 비워 두면 replay 로만 돌아갑니다. 넣기 전까지 실제 호출은 일어나지 않습니다.
ANTHROPIC_API_KEY=


# ── 재생(replay) 산출물 위치 ───────────────────────────────────
# KRPL_LLM_BACKEND=replay 일 때 어디서 응답을 읽을지.
# 비워 두면 tests/fixtures/trackb/ 를 씁니다. 보통 건드릴 일이 없습니다.
KRPL_REPLAY_DIR=


# ═══════════════════════════════════════════════════════════════
#  넣고 나서 확인하는 법
#
#    ./scripts/dev.sh env          ← 무엇이 실제로 반영됐는지 출력 (키는 가려집니다)
#
#  실제 호출을 한 건만 시험해 보려면
#
#    ./scripts/dev.sh assess R2026-0002 --force
#
#  그다음 감사 화면에서 `claude-opus-5` 로 바뀌었는지 확인하십시오.
#  (재생으로 돌면 `replay:claude-opus-5` 로 남습니다)
#
#    ./scripts/dev.sh audit R2026-0002
# ═══════════════════════════════════════════════════════════════
